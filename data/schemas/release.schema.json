{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "website_release_id",
    "analytical_build_id",
    "analytical_source_sha256",
    "available_school_years",
    "files"
  ],
  "properties": {
    "website_release_id": {
      "type": "string"
    },
    "analytical_build_id": {
      "const": "AAE-FULL-9c94bc374ab5e7cf29"
    },
    "analytical_source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "available_school_years": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
